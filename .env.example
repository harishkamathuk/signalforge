# Local WSL development PostgreSQL connection.
# Copy to your shell/environment management mechanism; SignalForge does not auto-load this file.
DATABASE_URL=postgresql+psycopg://signalforge:change-me@localhost:5432/signalforge

# OpenAlgo external adapter configuration. Never commit a real API key.
OPENALGO_HOST=http://127.0.0.1:5000
OPENALGO_API_KEY=replace-with-openalgo-api-key
OPENALGO_CONNECT_TIMEOUT_SECONDS=5
OPENALGO_REQUEST_TIMEOUT_SECONDS=10

# OpenAlgo live market-data WebSocket (SF-056)
OPENALGO_WS_URL=ws://127.0.0.1:8765
OPENALGO_STALE_AFTER_SECONDS=15
OPENALGO_RECONNECT_ATTEMPTS=3
OPENALGO_RECONNECT_DELAY_SECONDS=1
OPENALGO_WS_CONNECT_TIMEOUT_SECONDS=5
OPENALGO_WS_RECEIVE_TIMEOUT_SECONDS=5
